<style>/* Shared by all themes: paper, pagination, print fidelity, density, screen presentation, custom-section parts. */

/* Paper. Page 1 has no margin (the theme's padding is the margin, so a one-page resume looks exactly as designed).
   Later pages keep a bottom margin for the page number; the theme's padding repeats on every page (box-decoration-break below).
   The page number is a margin box: it never enters the DOM; in the PDF text layer it sits between the pages' content. */
@page {
  size: A4;
  margin: 0 0 10mm;
  @bottom-right { content: counter(page) " / " counter(pages); vertical-align: top; padding-top: 1mm; margin-right: var(--folio-right, 16mm); font: 400 7pt/1 Inter, "IBM Plex Sans", system-ui, sans-serif; color: #8a8f99; }
}
@page :first { margin: 0; @bottom-right { content: none; } }
@page letter { size: letter; }
body[data-paper="letter"] { page: letter; }

:root { --paper-w: 210mm; --paper-h: 297mm; }
:root:has(body[data-paper="letter"]) { --paper-w: 215.9mm; --paper-h: 279.4mm; }

/* Density: themes multiply their vertical gaps by --d and their line heights by --lh. Font sizes never change. */
body { --d: 1; --lh: 1; }
body[data-density="compact"] { --d: 0.72; --lh: 0.94; }
body[data-density="relaxed"] { --d: 1.3; --lh: 1.06; }
/* meta.colors: accent: what can be clicked, and the tech stack, take the accent. Colour only — no size or
   spacing changes, so pages and the text layer stay the same. The stack is mixed with the theme's ink to stay readable. */
body[data-colors="accent"] .page a { color: var(--accent); }
body[data-colors="accent"] .page .stack, body[data-colors="accent"] .page .chips { color: color-mix(in srgb, var(--accent) 70%, var(--ink, #15171c)); }
body[data-colors="accent"] .page .stack .sep, body[data-colors="accent"] .page .chips .sep { color: color-mix(in srgb, var(--accent) 30%, white); }

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; -webkit-font-smoothing: antialiased; }
body { margin: 0; background: #e8e8eb; }
h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
ul, ol { list-style: none; }
a { color: inherit; text-decoration: none; }
img { display: block; }

.page {
  width: var(--paper-w);
  min-height: var(--paper-h);
  margin: 32px auto;
  background: #fff;
  box-shadow: 0 1px 2px rgb(0 0 0 / 6%), 0 12px 40px rgb(0 0 0 / 10%);
}

/* Pagination: entries may split between bullets, never inside a bullet or right after a heading. */
.page h2, .page h3, .page .head, .page .entry > .org, .page .entry > .summary { break-after: avoid; }
.page .bullets > li:first-child, .page .stack, .page .chips, .page .entry .tags { break-before: avoid; }
.page li, .page .fact, .page dt, .page dd { break-inside: avoid; }
.page p, .page li { orphans: 2; widows: 2; }

/* Visible separators between list items (certifications, languages, stack): real text, so the PDF text layer reads "a · b". */
.page .sep { color: var(--sep, #b4b8c0); }

/* Inline \`code\`: mono on a light ground, never mistaken for a link. */
.page code { font: 400 0.88em/1 "IBM Plex Mono", ui-monospace, monospace; padding: 0.12em 0.2em; margin: 0 -0.2em; border-radius: 2px; background: #eef0f3; color: inherit; }

/* No position:relative/absolute on anything that carries text: Chromium paints positioned boxes in a separate layer and
   scrambles the PDF text order. Text-free decoration (e.g. split's sidebar tint) may be positioned.
   Letter-spaced text (uppercase headings) sets \`font-kerning: none\`: a kerning pair (LA, TY, AV) plus letter-spacing
   leaves a gap pdf.js reads as a space, and "LANGUAGES" becomes "L ANGUAGES" in the text layer. */
:root {
  --tag-accent: var(--accent);
  --tag-blue: #2563c9;
  --tag-green: #1c7c4a;
  --tag-orange: #b85a0b;
  --tag-red: #b7352d;
  --tag-gray: #5d6370;
}
/* Tags: tinted ground plus a hairline outline, so they keep their shape in greyscale print. */
.tag { --c: var(--tag-accent); display: inline-block; padding: 0.04em 0.55em; border: 0.5pt solid color-mix(in srgb, var(--c) 40%, white); border-radius: 999px; font-size: 0.88em; font-weight: 500; line-height: 1.3; white-space: nowrap; color: var(--c); background: color-mix(in srgb, var(--c) 10%, white); }
.tag-accent { --c: var(--tag-accent); }
.tag-blue { --c: var(--tag-blue); }
.tag-green { --c: var(--tag-green); }
.tag-orange { --c: var(--tag-orange); }
.tag-red { --c: var(--tag-red); }
.tag-gray { --c: var(--tag-gray); }
.tags { display: flex; flex-wrap: wrap; gap: 1mm 0.6mm; }
.tags .ti { white-space: nowrap; }
.tags .sep { font-size: 0.9em; }

.grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: calc(1.6mm * var(--d)) 5mm; }
.cell { min-width: 0; }
.cell .bullets { margin-top: 0; }
.grid .group strong { display: block; }

.group + .group, .text + .text, .text + .group, .group + .text { margin-top: calc(0.8mm * var(--d)); }
.group strong { font-weight: 600; }

/* Checklist item: the box is drawn by::before (content:"" keeps it out of the PDF text layer). Done = filled accent with a white tick. */
.page .bullets li.check::before { content: ""; width: 2.5mm; height: 2.5mm; margin: 0.2em 0 0 0; border: 0.7pt solid var(--muted); border-radius: 0.6mm; background: #fff; }
.page .bullets li.check[data-done="true"]::before { border-color: var(--accent); background: var(--accent) url("data:image/svg+xml,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 10 10'%3E%3Cpath d='M2 5.3l2.2 2.2L8 3' fill='none' stroke='white' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") center / 100% no-repeat; }

/* "Ort, Datum" + signature at the end of a resume (meta.signature): a right-aligned column of ordinary text, never
   positioned; kept on one page. Themes set the name's font. */
.page .sign { display: flex; flex-direction: column; align-items: flex-end; margin-top: calc(6mm * var(--d)); text-align: right; break-inside: avoid; }
.page .sign-date { color: var(--muted, #5f6571); }
.page .sign-img { height: 14mm; width: auto; max-width: 52mm; margin: 1.5mm 0 0.5mm; object-fit: contain; }
.page .sign-date + .sign-name { margin-top: 2.5mm; }
.page .sign-name { font-weight: 600; }

/* Cover letter, DIN 5008-inspired: letterhead (the theme's header), recipient block with "Ort, Datum" on its
   right (one flex row, DOM = reading order), bold subject without "Betreff:", salutation, paragraphs, closing,
   signature, name. Everything is ordinary text in DOM order. Themes set --l-indent (left edge of the text column),
   fonts and colours. Body copy is set larger than the resume (10.2pt): a letter is read, not scanned. */
.page.letter .l-body { font-size: var(--l-fs, 10.2pt); line-height: calc(1.5 * var(--lh)); padding-left: var(--l-indent, 0); }
.page.letter .l-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 10mm; margin-top: calc(var(--l-top, 13mm) * var(--d)); }
.page.letter .l-recipient { line-height: 1.42; }
.page.letter .l-date { margin-left: auto; white-space: nowrap; color: var(--muted, #5f6571); }
.page.letter .l-subject { margin-top: calc(11mm * var(--d)); font-weight: 600; }
.page.letter .l-salutation { margin-top: calc(6.5mm * var(--d)); }
.page.letter .l-text { margin-top: calc(3.2mm * var(--d)); }
.page.letter .l-text p + p { margin-top: calc(3.2mm * var(--d)); }
.page.letter .l-sign { margin-top: calc(5mm * var(--d)); break-inside: avoid; }
.page.letter .l-sig { display: block; height: 15mm; width: auto; max-width: 55mm; margin: 1.5mm 0 0.5mm -1mm; object-fit: contain; }
/* No image: room for a handwritten signature on the printout. */
.page.letter .l-closing + .l-signer { margin-top: 13mm; }
/* DIN fold marks (105 / 210 mm) and the hole mark (148.5 mm): text-free hairlines on the left edge, A4 only. */
body[data-doc="letter"][data-paper="a4"] .page.letter {
  background-image: linear-gradient(#c3c7ce, #c3c7ce), linear-gradient(#c3c7ce, #c3c7ce), linear-gradient(#c3c7ce, #c3c7ce);
  background-repeat: no-repeat;
  background-size: 4mm 0.5pt, 6mm 0.5pt, 4mm 0.5pt;
  background-position: 0 105mm, 0 148.5mm, 0 210mm;
}

/* Text-free chevron drawn with borders (a "›" glyph would end up in the PDF text layer). */
.chev { display: inline-block; width: 0.34em; height: 0.34em; margin: 0 0.5em 0.12em 0.05em; border: solid currentColor; border-width: 0.1em 0.1em 0 0; transform: rotate(45deg); }

@media print {
  body { background: none; }
  .page { margin: 0; box-shadow: none; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
}

/* Web version on narrow screens: drop the sheet metaphor. */
@media screen and (max-width: 840px) {
  body { background: #fff; }
  .page { width: auto; min-height: 0; margin: 0; box-shadow: none; }
}
</style>
<style>:root { --folio-right: 16mm; }
.theme-classic {
  --ink: #1a1a1a;
  --soft: #333;
  --muted: #616161;
  --rule: #d6d6d6;
  --col: 30mm;
  --serif: Newsreader, Georgia, serif;
  font: 400 9.2pt/calc(1.38 * var(--lh)) Inter, system-ui, sans-serif;
  color: var(--ink);
}
.theme-classic .page { padding: 13mm 16mm 11mm; }
.theme-classic strong { font-weight: 600; }
.theme-classic .sep { color: #a8a8a8; }

/* Header: name with the contact block top right (letterhead), title under the name across the page; portrait far right. */
.theme-classic header { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name contact" "title title"; column-gap: 6mm; align-items: end; }
.theme-classic header.with-photo { grid-template-columns: minmax(0, 1fr) 30mm; grid-template-areas: "name photo" "title photo" "contact photo"; grid-template-rows: auto auto 1fr; align-items: start; }
.theme-classic header.with-photo h1 { padding-top: 3mm; }
.theme-classic header.with-photo .contact { max-width: none; margin-top: 2.6mm; text-align: left; }
.theme-classic h1 { grid-area: name; font: 500 26pt/1.05 var(--serif); letter-spacing: -0.01em; word-spacing: 0.12em; font-variation-settings: "opsz" 72; }
.theme-classic .title { grid-area: title; margin-top: 1.4mm; font-size: 10.5pt; font-weight: 500; color: var(--soft); }
.theme-classic .contact { grid-area: contact; max-width: 95mm; text-align: right; font-size: 8.4pt; line-height: 1.5; color: var(--soft); }
.theme-classic .contact .seg { white-space: nowrap; }
.theme-classic .photo { grid-area: photo; align-self: start; width: 30mm; height: 40mm; object-fit: cover; border: 0.5pt solid #c8c8c8; }

/* Headings: serif, own line, accent hairline underneath (the only accent on the page). */
.theme-classic section { margin-top: calc(2.3mm * var(--d)); }
.theme-classic h2 { font: 600 11.5pt/1.15 var(--serif); padding-bottom: 0.4mm; border-bottom: 0.75pt solid var(--accent); margin-bottom: calc(1.4mm * var(--d)); }
.theme-classic .lead { line-height: calc(1.48 * var(--lh)); }

/* Rows: dates or labels left, details right. */
.theme-classic .row { display: grid; grid-template-columns: var(--col) minmax(0, 1fr); column-gap: 5mm; }
.theme-classic .row + .row { margin-top: calc(2mm * var(--d)); }
.theme-classic .table .row + .row, .theme-classic .fact + .fact { margin-top: calc(0.7mm * var(--d)); }
/* Skill and language labels may outgrow the date column ("Programmiersprachen"): that table widens instead of overlapping. */
.theme-classic .table { display: grid; grid-template-columns: minmax(var(--col), max-content) minmax(0, 1fr); column-gap: 5mm; }
.theme-classic .table .row { display: contents; }
.theme-classic .table .row + .row > * { padding-top: calc(0.7mm * var(--d)); }
.theme-classic .when { display: block; font-size: 8.4pt; color: var(--soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
.theme-classic .where { display: block; font-size: 8pt; color: var(--muted); }
.theme-classic .row > .l { padding-top: 0.3mm; }
.theme-classic .table .l { padding-top: 0; }
.theme-classic .link { margin-top: 0.2mm; font-size: 8pt; color: var(--muted); break-after: avoid; }
.theme-classic .link .seg { white-space: nowrap; }
.theme-classic .label { font-weight: 600; }
.theme-classic h3 { font-size: 9.7pt; font-weight: 600; }
.theme-classic .org { font-weight: 500; color: var(--soft); }
.theme-classic .approach li + li { margin-top: calc(0.6mm * var(--d)); }
.theme-classic .place { color: var(--muted); }
.theme-classic .cert { font-weight: 500; }
.theme-classic .summary { margin-top: 0.4mm; color: var(--muted); }
.theme-classic .bullets { margin-top: calc(0.9mm * var(--d)); }
.theme-classic .bullets li { display: grid; grid-template-columns: 3.6mm 1fr; }
.theme-classic .bullets li + li { margin-top: calc(0.35mm * var(--d)); }
.theme-classic .bullets li::before { content: ""; width: 1.8mm; height: 0.6pt; margin: 0.7em 0 0 0.2mm; background: #6f6f6f; }
.theme-classic .stack { margin-top: calc(0.6mm * var(--d)); padding-left: 3.6mm; font-size: 8.4pt; color: var(--muted); }

/* Custom sections */
.theme-classic .custom .bullets { margin-top: 0; }
.theme-classic .custom .entry .bullets { margin-top: calc(0.9mm * var(--d)); }
.theme-classic .entry .tags { margin-top: calc(1.1mm * var(--d)); }
.theme-classic .tag { font-size: 0.86em; }

@media screen and (max-width: 840px) {
  .theme-classic .page { padding: 28px 20px; }
  .theme-classic .row, .theme-classic .table { grid-template-columns: 1fr; }
  .theme-classic header, .theme-classic header.with-photo { grid-template-columns: 1fr; grid-template-areas: "photo" "name" "title" "contact"; }
  .theme-classic .contact { text-align: left; margin-top: 8px; }
}
.theme-classic .langs .sep { margin: 0 0.35em; }

/* German CV fields: the traditional close — "Ort, Datum", signature, name in the heading serif. */
.theme-classic .contact .avail { color: var(--ink); font-weight: 500; }
.theme-classic .sign { margin-top: calc(5mm * var(--d)); }
.theme-classic .sign-name { font: 600 11.5pt/1.15 var(--serif); }

/* Cover letter: the letterhead (name left, address block right) over the accent hairline; serif subject
   and signed name — the theme's traditional voice. DIN-like margins. */
.theme-classic .page.letter { padding: 14mm 20mm 12mm 25mm; --l-top: 12mm; }
.theme-classic .letter header { padding-bottom: 3.2mm; border-bottom: 0.75pt solid var(--accent); }
.theme-classic .l-subject { font: 600 12pt/1.3 var(--serif); }
.theme-classic .l-signer { font: 600 11.5pt/1.15 var(--serif); }
</style>
<style>:root { --accent: #123456; }</style>
</head>
<body class="theme-classic" data-paper="letter" data-density="relaxed">
<main class="page">
<header>
  <h1>Fictional Preview Person</h1>
  <p class="title">AI Engineer — LLM applications &amp; agents</p>
  <div class="contact"><p>42 Fictional Avenue</p><p>+49 555 12345678<span class="sep">&nbsp;· </span><a href="mailto:preview@example.test">preview@example.test</a></p></div>
  
</header>
<section><h2>Profile</h2><p class="lead">AI engineer in software since 2019, shipping LLM products to production since 2024. I turn fuzzy business problems into <strong>measurable</strong> agent and retrieval systems — with evals, cost budgets and a clear path from prototype to on-call.</p></section>
<section><h2>AI Workflow</h2><ul class="approach"><li><strong>Evals before features.</strong> Every prompt or model change ships with a regression set and an LLM-as-judge rubric.</li><li><strong>Agents as teammates.</strong> I pair with coding agents daily and keep a reviewed library of skills and guardrails.</li><li><strong>Cost is a feature.</strong> Routing, caching and small-model fallbacks are designed in from day one, not bolted on.</li></ul></section>
<section><h2>Experience</h2><div class="row entry"><div class="l"><span class="when">Feb 2024 – Present</span><span class="where">Berlin · hybrid</span></div><div class="r"><h3>Senior AI Engineer <span class="org">— Northwind Analytics</span></h3><ul class="bullets"><li><span>Led the document-intelligence agent used by <strong>40+ enterprise customers</strong>; cut manual review time by <strong>63%</strong>.</span></li><li><span>Built a hybrid RAG stack (BM25 + embeddings + reranker), lifting answer accuracy from <strong>71% to 89%</strong> on a 1.2k-question eval set.</span></li><li><span>Introduced prompt caching and routing to a LoRA-tuned small model, reducing inference cost per request by <strong>48%</strong> at equal quality.</span></li></ul><p class="stack">Python, FastAPI, Claude, pgvector, LangGraph, Langfuse, AWS</p></div></div><div class="row entry"><div class="l"><span class="when">Jun 2021 – Jan 2024</span><span class="where">Munich</span></div><div class="r"><h3>Machine Learning Engineer <span class="org">— Fieldline</span></h3><ul class="bullets"><li><span>Shipped a support-ticket triage model handling <strong>12k tickets/day</strong> with 94% routing precision.</span></li><li><span>Designed the team&#39;s first offline evaluation harness and CI gate for model releases.</span></li></ul><p class="stack">PyTorch, scikit-learn, Airflow, Docker, GCP</p></div></div><div class="row entry"><div class="l"><span class="when">Sep 2019 – May 2021</span><span class="where">Munich</span></div><div class="r"><h3>Software Engineer <span class="org">— Tessera Labs</span></h3><ul class="bullets"><li><span>Built data pipelines and internal tools in TypeScript, Python and SQL for a 30-person analytics team.</span></li></ul><p class="stack">TypeScript, Node.js, PostgreSQL</p></div></div></section>
<section><h2>Projects</h2><div class="row entry"><div class="l"></div><div class="r"><h3>Receipt Copilot <span class="org">— Open-source bookkeeping agent</span></h3><p class="link"><a href="https://github.com/example/receipt-copilot"><span class="seg">github.com/</span><wbr><span class="seg">example/</span><wbr><span class="seg">receipt-copilot</span></a></p><ul class="bullets"><li><span>Vision + tool-calling agent that files German receipts into accounting categories; <strong>1.3k GitHub stars</strong>.</span></li></ul><p class="stack">TypeScript, Claude, MCP, Playwright</p></div></div><div class="row entry"><div class="l"></div><div class="r"><h3>AI Energy Berlin hackathon <span class="org">— Winner, 1st of 38 teams</span></h3><ul class="bullets"><li><span>Built a multi-agent planner for household energy usage in 24 hours.</span></li></ul><p class="stack">Python, Next.js</p></div></div></section>
<section><h2>Skills</h2><div class="table"><div class="row"><div class="l"><span class="label">LLM &amp; Agents</span></div><div class="r"><p>RAG, tool use / MCP, multi-agent orchestration, evals, fine-tuning (LoRA)</p></div></div><div class="row"><div class="l"><span class="label">Programming</span></div><div class="r"><p>Python, TypeScript, SQL</p></div></div><div class="row"><div class="l"><span class="label">Infra</span></div><div class="r"><p>Docker, AWS, GCP, Postgres, CI/CD, observability</p></div></div></div></section>
<section><h2>Education</h2><div class="row entry"><div class="l"><span class="when">2017 – 2019</span></div><div class="r"><h3>M.Sc. Informatics <span class="org">— Technical University of Munich</span></h3><p class="summary">Thesis on retrieval-augmented question answering.</p></div></div></section>
<section><h2>Certifications</h2><div class="row fact"><div class="l"><span class="when">2020</span></div><div class="r"><p><span class="cert">Example certification</span><span class="place">, Example institute</span></p></div></div></section>
<section><h2>Languages</h2><p class="langs"><span><span class="label">English</span> fluent (C1)</span><span class="sep">&nbsp;· </span><span><span class="label">German</span> professional (B2)</span><span class="sep">&nbsp;· </span><span><span class="label">Chinese</span> native</span></p></section>
<section class="custom"><h2>Selected work</h2><div class="row entry"><div class="l"><span class="when">2020 – 2021</span></div><div class="r"><h3>Example <span class="org">— Subheading</span></h3><p class="summary">Details</p><ul class="bullets"><li><span>Delivered</span></li></ul><p class="tags"><span class="ti"><span class="tag tag-blue">TypeScript</span></span></p></div></div></section>
<section class="custom"><h2>Notes</h2><p class="text">A note</p></section>
<section class="custom"><h2>Highlights</h2><div class="grid" style="--cols:2"><div class="cell"><ul class="bullets"><li><span>A highlight</span></li></ul></div></div></section>
<section class="custom"><h2>Tags</h2><p class="tags"><span class="ti"><span class="tag tag-green">Example</span></span></p></section>
</main>
</body>
</html>",
  "ok": true,
  "uncovered": [],
}
`;

