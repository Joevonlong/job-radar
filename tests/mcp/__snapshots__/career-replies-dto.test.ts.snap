    "name",
    "years",
  ],
  "$.properties.profile.properties.summary.anyOf[0]": [
    "id",
    "primary",
    "wordings",
  ],
  "$.properties.profile.properties.summary.anyOf[0].properties.wordings.items": [
    "created_at",
    "from_document",
    "from_story",
    "id",
    "label",
    "lang",
    "origin",
    "text",
  ],
  "$.properties.versions.items": [
    "createdAt",
    "hash",
    "id",
  ],
}
`;

exports[`career and reply output allow-lists > pins every field of list_career_documents > list_career_documents 1`] = `
{
  "$": [
