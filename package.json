{
  "name": "job-radar",
  "version": "2.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Zhou Long",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joevonlong/job-radar.git"
  },
  "bugs": {
    "url": "https://github.com/Joevonlong/job-radar/issues"
  },
  "homepage": "https://github.com/Joevonlong/job-radar#readme",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx scripts/i18n-catalog.ts && tsx scripts/web-run.ts dev",
    "build": "tsx scripts/i18n-catalog.ts && next build",
    "start": "tsx scripts/web-run.ts start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright test --config playwright.setup.config.ts",
    "demo:shots": "scripts/demo-shots.sh",
    "config:check": "tsx scripts/config-check.ts",
    "i18n:catalog": "tsx scripts/i18n-catalog.ts",
    "i18n:check": "tsx scripts/i18n-catalog.ts --check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "ci:docs-check": "tsx scripts/check-ci-docs.ts",
    "config:init": "tsx scripts/config-init.ts",
    "config:migrate": "tsx scripts/config-migrate.ts",
    "config:example": "tsx scripts/config-example.ts",
    "market:show": "tsx scripts/market-show.ts",
    "market:regress": "node --env-file-if-exists=.env --import tsx scripts/market-regress.ts",
    "sources:list": "node --env-file-if-exists=.env --import tsx scripts/sources-list.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db-seed.ts",
    "runner": "node --env-file-if-exists=.env --import tsx src/runner/index.ts",
    "ai-worker": "node --env-file-if-exists=.env --import tsx src/ai-worker/index.ts",
    "simhash:analyze": "node --env-file-if-exists=.env --import tsx scripts/simhash-analyze.ts",
    "ai:usage-stats": "node --env-file-if-exists=.env --import tsx scripts/ai-usage-stats.ts",
    "ai:probe": "node --env-file-if-exists=.env --import tsx scripts/ai-probe.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "mcp:serve": "node --env-file-if-exists=.env --import tsx scripts/mcp-serve.ts",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "migrate:run": "node --env-file-if-exists=.env --import tsx scripts/migrate-run.ts",
    "ops:drain": "node --env-file-if-exists=.env --import tsx scripts/ops-drain.ts",
    "cycle:run": "node --env-file-if-exists=.env --import tsx scripts/cycle-run.ts",
    "refilter": "node --env-file-if-exists=.env --import tsx scripts/refilter.ts",
    "reprocess": "node --env-file-if-exists=.env --import tsx scripts/reprocess.ts",
    "company-names": "node --env-file-if-exists=.env --import tsx scripts/company-names.ts",
    "telegram:test": "node --env-file-if-exists=.env --import tsx scripts/telegram-test.ts",
    "score:smoke": "node --env-file-if-exists=.env --import tsx scripts/score-smoke.ts",
    "score:queue": "node --env-file-if-exists=.env --import tsx scripts/score-queue.ts",
    "suggest:smoke": "node --env-file-if-exists=.env --import tsx scripts/suggest-smoke.ts",
    "traps:scan": "node --env-file-if-exists=.env --import tsx scripts/traps-scan.ts",
    "salary:benchmark": "node --env-file-if-exists=.env --import tsx scripts/salary-benchmark.ts",
    "smoke:signals": "node --env-file-if-exists=.env --import tsx scripts/signals-smoke.ts",
    "smoke:brightdata": "node --env-file-if-exists=.env --import tsx scripts/smoke-brightdata.ts",
    "smoke:apify": "node --env-file-if-exists=.env --import tsx scripts/smoke-apify.ts",
    "smoke:jsearch": "node --env-file-if-exists=.env --import tsx scripts/smoke-jsearch.ts",
    "auth:linkedin": "node --env-file-if-exists=.env --import tsx scripts/auth-linkedin.ts",
    "web:password": "tsx scripts/web-password.ts",
    "build:runner": "tsx scripts/i18n-catalog.ts && esbuild runner=src/runner/index.ts healthcheck=src/runner/healthcheck.ts --bundle --external:playwright-core --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.2.10",
    "lucide-react": "^1.52.0",
    "mailparser": "^3.9.36",
    "motion": "14.0.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "playwright-core": "^1.64.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
