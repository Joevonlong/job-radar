# Copy to .env (gitignored) and edit. Every variable is optional: the compose file and the
# code carry safe local defaults. Never commit real values.

# ---- Instance names (only for a SECOND instance on the same machine: docs/multiple-instances.md) ------------
# One person = one instance. A second checkout needs its own compose project, database volume and ports, or it takes over
# this one's containers and database. Leave all four empty for the first (or only) instance: the defaults ARE its names,
# and changing them on an existing install makes it start with an empty database.
# COMPOSE_PROJECT_NAME=job-radar
# JOBRADAR_PG_VOLUME=jobradar-pg
# (and JOB_RADAR_WEB_PORT, DB_HOST_PORT below)

# ---- Linux: who owns data/ -------------------------------------------------------------------------------------
# The web and runner containers run as this uid:gid (default 1000:1000) and must be able to write data/config,
# data/profile, data/backups and data/exports. On Linux set them to your own ids when they are not 1000: `id -u`, `id -g`.
# Not needed on macOS (Docker Desktop maps file ownership).
PUID=
PGID=

# ---- Postgres (compose `db` service) ------------------------------------------------------
# Defaults are for local use only; the db port is published on 127.0.0.1 only.
# Use URL-safe characters in the password (it is embedded in DATABASE_URL for web/runner).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port for the loopback-only db mapping (default 5433). Used by host-side tooling.
DB_HOST_PORT=

# ---- Host-side tooling (pnpm runner / db:* / cycle:run ...) ---------------------------------------
# Containers get their DATABASE_URL from compose.yaml and ignore this value.
# Leave it unset: host commands (pnpm ai-worker, cycle:run, refilter, ...) then build it from POSTGRES_* and
# DB_HOST_PORT above (defaults: postgres://jobradar:jobradar@127.0.0.1:5433/jobradar). Set it only to point at another database.
# DATABASE_URL=
# The database tests (pnpm test:integration, test:e2e) never use this installation: they read DATABASE_URL from the shell
# only and need a disposable Postgres, see docs/development.md.
# Max pooled connections per process (default 10).
DB_POOL_MAX=
# Seconds to wait for a new connection (default 5; raise it on a busy machine).
DB_CONNECT_TIMEOUT_SECONDS=
# Directory with the SQL migrations, relative to the working directory (default "drizzle").
MIGRATIONS_DIR=

# Config file names below (ai.yaml, sources.yaml ...) are files in your config directory (data/config/); the Settings page edits them.

# ---- Config directories -----------------------------------------------------------
# Two layers: the shipped defaults (tracked in git, read-only) and your own config (not in git; the web saves here, and
# a file here wins over the default of the same name). `pnpm config:init` copies the defaults into your directory.
# Relative values resolve against the project directory. Compose sets /app/config and /app/data/config for the containers and
# ignores these values; host-side tools (pnpm runner / ai-worker / doctor / config:*) read them.
# JOB_RADAR_DEFAULTS_DIR=config
# JOB_RADAR_CONFIG_DIR=data/config
# JOB_RADAR_PROFILE_DIR=data/profile
# How often (ms) config files are re-checked for changes made by another process or by hand: the web / MCP server's on-demand check and
# the watchers' polling (default 5000; 0 turns both off).
# JOB_RADAR_CONFIG_POLL_MS=5000

# Log level of the web app, the runner, the ai-worker and pnpm cycle:run: debug, info, warn or error. Wins over
# schedule.yaml logging.level (default info); empty = not set; any other value is ignored with a warning. After a change:
# docker compose up -d (not restart) and restart the ai-worker. See docs/configuration.md "Log level".
# JOB_RADAR_LOG_LEVEL=

# ---- Runner -------------------------------------------------------------------------------
# Seconds between runner heartbeats (default 30).
RUNNER_HEARTBEAT_SECONDS=
# Heartbeat rows older than this many hours are pruned (default 24).
RUNNER_HEARTBEAT_RETENTION_HOURS=
# The runner container turns "unhealthy" when its newest heartbeat is older than this many seconds (default 120).
RUNNER_HEALTH_MAX_AGE_SECONDS=
# Directory of the daily pg_dump backups for host-side runs (default data/backups; compose sets /app/data/backups).
RUNNER_BACKUP_DIR=
# pg_dump executable for host-side runs only (default pg_dump; major version >= the server's, 17). The container uses its own.
PG_DUMP_PATH=
# pg_restore executable that validates each finished backup (default pg_restore; same major version as pg_dump).
PG_RESTORE_PATH=
# Container log rotation (json-file driver): size of one log file and number of files kept per service.
LOG_MAX_SIZE=
LOG_MAX_FILE=
# Memory caps of the runner (Chromium for linkedin-session) and the jobspy sidecar: a runaway browser or scrape is killed
# and restarted instead of taking the host down. Docker size syntax (512m, 2g). Defaults 2g / 1g.
RUNNER_MEM_LIMIT=
JOBSPY_MEM_LIMIT=

# ---- jobspy sidecar ---------------------------------------------------------------
# Base URL of the python-jobspy sidecar for host-side runs (pnpm cycle:run / runner). Overrides
# the jobspy.url setting in sources.yaml (default http://127.0.0.1:8000). Compose sets http://jobspy:8000 for the runner.
# Locally: `cd jobspy && uv venv --python 3.12 .venv && uv pip install -r requirements.txt --python .venv/bin/python
#          && .venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000`, or publish the compose port temporarily
#          with `docker compose run --rm --service-ports jobspy`.
JOBSPY_URL=

# ---- AI providers -----------------------------------------
# AI runs in the ai-worker on the host (ai.yaml: execution: host), using the local subscription logins of
# `claude` (run `claude`, then /login) and `codex` (`codex login`). Nothing is needed here for that, and the
# containers get no AI credential. Order: codex-cli -> claude-cli -> API (anthropic, deepseek, mimo);
# ai.yaml decides. A provider without its credential is skipped. `pnpm ai:probe` shows which ones work.
# The pay-per-token API providers are off unless you fill a key in; the ai-worker (not the container) reads it
# from this file. They are capped by monthly_api_budget_usd in ai.yaml. DeepSeek and MiMo are also switched off in
# ai.yaml by default (providers.deepseek / providers.mimo: enabled).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
# API keys, the Telegram token and the Gmail login are only sent to the vendors' own hosts, whatever base_url / api_base_url
# / sources.gmail the config files say. Set to 1 only if you really route them through a proxy or gateway of your own (logged as a warning;
# docs/ai-providers.md "What the ai-worker does not take from ai.yaml").
# JOB_RADAR_ALLOW_CUSTOM_ENDPOINTS=1
# Only for `execution: container` (not recommended): a token from `claude setup-token` for the runner container.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Telegram ----------------------------------------------------
# Easiest: `pnpm run setup --step telegram` asks for the token, finds the chat id, sends a test message,
# writes these three lines (with a backup of this file) and restarts the services. Or fill them in by hand:
# bot token from @BotFather and the numeric id of the chat the bot talks to (docs/telegram.md).
# Messages are only sent to, and button presses only accepted from, this one chat. Switch the push on
# with `telegram.enabled: true` in notify.yaml; `pnpm telegram:test` sends a test message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for a group chat: comma-separated numeric Telegram user ids allowed to press the buttons (docs/telegram.md). Empty: anyone in the chat.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Board discovery --------------------------------------------------------------
# Tavily API key (https://app.tavily.com, the free plan has 1000 credits a month; docs/tavily.md).
# Without it the `tavily` channel is "not configured" and does nothing; with it, about once a day it
# searches for new ATS boards and lists them on /sources for you to add to the `ats_boards` list in sources.yaml.
TAVILY_API_KEY=
# Brave Search API key, only for the `brave` channel, which is off by default (sources.brave.enabled in
# sources.yaml); Tavily is the recommended alternative.
BRAVE_SEARCH_API_KEY=

# ---- Gmail job-alert emails --------------------------------------
# Gmail address and 16-character app password (needs 2-step verification; see docs/gmail-alerts.md).
# The gmail-alerts channel reads one label read-only; switch it on with `sources.gmail.enabled: true` in sources.yaml.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- LinkedIn via Bright Data ------------------------------------
# Bright Data API key (docs/brightdata.md). The linkedin-brightdata channel, first in the LinkedIn cascade, is billed to
# your Bright Data account. Without a key the channel is "not configured" and the cascade skips it.
BRIGHT_DATA_API_KEY=

# ---- LinkedIn via Apify ------------------------------------------
# Apify API token (Apify Console -> Settings -> API & Integrations; docs/apify.md). The linkedin-apify
# channel, second in the LinkedIn cascade, runs the actor from sources.yaml: linkedin.apify.actor_id and
# is billed to your Apify account. Without a token the channel is "not configured" and the cascade skips it.
APIFY_TOKEN=

# ---- LinkedIn via Monid ------------------------------------------
# Workspace API key from app.monid.ai (docs/monid.md). The linkedin-monid channel is third in the LinkedIn
# cascade and bills your prepaid Monid wallet. Set a workspace spend cap in the Monid dashboard.
# Without a key the channel is "not configured" and skipped without a failure.
MONID_API_KEY=

# ---- JSearch / Google Jobs ---------------------------------------
# RapidAPI key of the JSearch API (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch; the free plan has
# 200 requests a month). Without it the `jsearch` channel is "not configured" and sends no request; switch it
# on with `sources.jsearch.enabled: true` in sources.yaml (see docs/jsearch.md).
JSEARCH_API_KEY=

# ---- Web access -------------------------------------------------------------------
# Extra host names the web answers to, comma-separated (default: only localhost, 127.0.0.1, [::1] and *.ts.net; anything
# else gets 421). Needed behind a reverse proxy (which must forward Host or X-Forwarded-Host) or for a LAN name / IP.
# `*.example.com` allows every name below example.com; `name:port` only that port. Restart the web after a change.
# JOB_RADAR_ALLOWED_HOSTS=jobs.example.com,192.168.1.20
# Set to 1 to let the web (settings forms, advanced editor) change the protected config keys: AI commands, API hosts,
# Codex overrides, scraping proxies, the Apify actor, Monid provider/endpoint, resume-kit paths, credential paths (docs/configuration.md). Off by default: edit those keys in the file by hand.
# JOB_RADAR_ALLOW_WEB_EDIT_PROTECTED=1
# (Separate from JOB_RADAR_ALLOW_CUSTOM_ENDPOINTS above: even with this set, keys only go to the vendors' own hosts unless that one is set too.)

# Host address and port the web is published on (defaults 127.0.0.1 and 3000; inside the container it is always 3000).
# 0.0.0.0 publishes it to your network: set a password first (below) and add the LAN name / IP to JOB_RADAR_ALLOWED_HOSTS,
# or requests get 421. With any address but loopback, requests from this machine need the password too.
# Without compose, `pnpm start` / `pnpm dev` make the web listen on this address; unset, they listen on every interface
# and requests from this machine need the password too (set 127.0.0.1 to keep the web on this machine without a login).
JOB_RADAR_WEB_BIND=
JOB_RADAR_WEB_PORT=
# Optional web password (docs/configuration.md "Web access"). Requests from this machine (127.0.0.1 / localhost) skip it;
# everything else (tailscale serve, a reverse proxy, the LAN) gets a login page. Recommended: the hash printed by
# `pnpm web:password` (it contains no `$`, so compose leaves it alone). The plain-text form is simpler but readable by
# anybody who can read this file; when both are set the hash wins. Then: docker compose up -d web.
JOB_RADAR_WEB_PASSWORD_HASH=
# JOB_RADAR_WEB_PASSWORD=
# Optional signing key of the login sessions (at least 32 characters). Without it the web creates
# data/config/.web-session-secret (mode 0600) on first use; changing either logs everybody out (so does the
# "Sign out everywhere" button on the settings page).
# JOB_RADAR_SESSION_SECRET=
# Set to 1: requests from this machine need the password too. Recommended as soon as the web is reachable from elsewhere
# by any route: a reverse proxy on this machine that sends Host: 127.0.0.1 without forwarding the client address, a TCP
# forward (tailscale serve --tcp, socat, ssh -R), or another container on the same Docker network would otherwise count as local.
# JOB_RADAR_WEB_LOCAL_LOGIN=1

# ---- pnpm run doctor ----------------------------------------------------------------
# Address of the dashboard as the host sees it. Default: derived from JOB_RADAR_WEB_BIND / JOB_RADAR_WEB_PORT when one of
# them is set, else doctor.web_url in schedule.yaml (http://127.0.0.1:3000). Only for pointing the health check elsewhere.
JOB_RADAR_DOCTOR_WEB_URL=
