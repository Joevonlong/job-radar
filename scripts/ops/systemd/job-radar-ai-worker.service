# systemd USER unit of the Job Radar ai-worker (Linux). scripts/ops/install-ai-worker.sh fills in the @...@ values and
# installs it as ~/.config/systemd/user/job-radar-ai-worker.service (mode 0600: it holds DATABASE_URL); the same script
# on macOS installs a launchd agent instead. The worker runs from a read-only release directory
# <main>/data/releases/ai-worker/<sha>/ (scripts/ops/prepare-release.sh); .env, logs and the user's config come from the
# main checkout <main>. Install it with the script, not by hand: it switches only when the new worker is proven ready and
# rolls back otherwise. Every value is an absolute path (`%` written as `%%`; inside quotes also `\\` and `\"` escaped,
# and `$` as `$$` in ExecStart).
#   loginctl enable-linger "$USER"     # keep it running while you are logged out (needs sudo on some systems)
# Logs: the worker writes <main>/data/logs/ai-worker.{out,err}.log itself; start-up failures and crashes are in
#   journalctl --user -u job-radar-ai-worker.service
[Unit]
Description=Job Radar ai-worker (AI steps with the local claude / codex logins)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@RELEASE_DIR@
# node loads tsx as a loader (not through the tsx CLI), so the process systemd tracks is the worker itself. The release's
# resolution guard comes first when the release has one (the install script writes `--import "<its file URL>" ` there).
ExecStart="@NODE_BIN@" @GUARD_IMPORT@--import "@TSX_LOADER@" "--env-file-if-exists=@ENV_FILE@" "@ENTRY@" --log-dir "@LOG_DIR@"
Environment="PATH=@PATH@"
Environment="DATABASE_URL=@DATABASE_URL@"
# empty on purpose: a NODE_OPTIONS of the user's session would make the release guard refuse to start
Environment="NODE_OPTIONS="
Environment="JOB_RADAR_DEFAULTS_DIR=@DEFAULTS_DIR@"
Environment="JOB_RADAR_CONFIG_DIR=@USER_CONFIG_DIR@"
Environment="JOB_RADAR_PROFILE_DIR=@PROFILE_DIR@"
Environment="JOB_RADAR_DATA_ROOT=@DATA_ROOT@"
Environment="TSX_TSCONFIG_PATH=@TSCONFIG@"
Restart=always
RestartSec=10
# SIGTERM to the worker only; it ends its own claude / codex children (ai.yaml host_worker.shutdown_grace_seconds)
KillMode=mixed
# deploy.ai_worker_stop_timeout_seconds (schedule.yaml): SIGKILL after this many seconds
TimeoutStopSec=@STOP_TIMEOUT@

[Install]
WantedBy=default.target
